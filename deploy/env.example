# =============================================================================
# GigaChad GRC - Environment Configuration
# =============================================================================
# Copy this file to .env.prod in the project root and update the values:
#   cp deploy/env.example .env.prod && chmod 600 .env.prod
# .env.prod is the only production env filename. Every deploy command passes
# --env-file .env.prod, docker-compose.prod.yml mounts it into the backup
# scheduler, and deploy/backup.sh, deploy/restore.sh, deploy/verify-backup.sh
# and scripts/validate-production.sh all read it.
# WARNING: Never commit a filled-in .env.prod to version control!
# =============================================================================

# =============================================================================
# GENERAL SETTINGS
# =============================================================================

# Application Environment (development, staging, production)
NODE_ENV=production

# Application Domain (without protocol)
APP_DOMAIN=grc.example.com

# Log level for all services (debug, info, warn, error)
LOG_LEVEL=info

# Timezone for the application
TZ=UTC

# Docker image tag (for versioned deployments)
IMAGE_TAG=latest

# =============================================================================
# DATABASE - PostgreSQL
# =============================================================================

# Database credentials (CHANGE THESE IN PRODUCTION!)
POSTGRES_USER=grc
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_DB=gigachad_grc

# Connection pooling settings (optional)
# DATABASE_POOL_MIN=5
# DATABASE_POOL_MAX=20

# =============================================================================
# AUTHENTICATION - Firebase Authentication (Google sign-in only)
# =============================================================================
# The Firebase ID token proves IDENTITY ONLY. Role, permissions and
# organization are read from PostgreSQL on every request, never from token
# claims: Firebase custom claims refresh at most hourly, so a revoked admin
# would keep their old role until the token expired.

# Firebase console > Project settings > General > "Project ID".
# Every accepted ID token must carry this as its `aud`/`iss` project.
FIREBASE_PROJECT_ID=

# Comma-separated list of email domains allowed to sign in.
# A Firebase ID token carries NO `hd` (hosted domain) claim, so this
# allowlist is the only thing stopping any Google account from authenticating.
ALLOWED_EMAIL_DOMAINS=example.com

# Create a user row on first sign-in instead of requiring one to exist.
# Leave false to restrict access to users provisioned by an administrator.
AUTH_AUTO_PROVISION=false

# Organization that auto-provisioned users are attached to; required only
# when AUTH_AUTO_PROVISION=true. Obtain with: SELECT id, name FROM organizations;
AUTH_DEFAULT_ORG_ID=

# The only auth bypass is AUTH_MODE=demo, and the backend guard hard-throws
# when NODE_ENV=production. Never set it here.
# AUTH_MODE=

# Frontend Firebase config. The Web API key is a PUBLIC identifier, not a
# secret: it is shipped in the browser bundle by design, and access is
# controlled by Firebase security rules and the domain allowlist above.
# Firebase console > Project settings > General > "Your apps" > Web app.
VITE_FIREBASE_API_KEY=
# Firebase console > Authentication > Settings > Authorized domains.
# Defaults to <project-id>.firebaseapp.com.
VITE_FIREBASE_AUTH_DOMAIN=example.firebaseapp.com
# Must be the same value as FIREBASE_PROJECT_ID above.
VITE_FIREBASE_PROJECT_ID=

# Pre-fills the domain in Google's account chooser so returning users see
# their work account first. COSMETIC ONLY - it restricts nothing. Anyone with
# any Google account can still complete the sign-in; ALLOWED_EMAIL_DOMAINS
# above is the control that actually rejects them. Build-time like the other
# VITE_* values, so changing it requires rebuilding the frontend image.
VITE_ALLOWED_EMAIL_DOMAIN=example.com

# =============================================================================
# OBJECT STORAGE - MinIO
# =============================================================================

# MinIO credentials (CHANGE THESE IN PRODUCTION!)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# MinIO browser console (on/off) - disable in production for security
MINIO_BROWSER=off

# MinIO domain
MINIO_DOMAIN=storage.grc.example.com

# =============================================================================
# SECURITY
# =============================================================================

# Sign-in is Firebase; the API verifies Google-issued RS256 ID tokens against
# Google's JWKS with the issuer and audience pinned to FIREBASE_PROJECT_ID.
# The application signs nothing itself, so there is no signing secret to set.

# Encryption key for sensitive data (integrations, credentials)
# REQUIRED: Must be at least 32 characters
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_TO_32_CHAR_RANDOM_STRING

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://grc.example.com

# =============================================================================
# RATE LIMITING
# =============================================================================

# Enable/disable rate limiting
RATE_LIMIT_ENABLED=true

# Maximum requests per window
RATE_LIMIT_MAX=100

# Rate limit window in milliseconds (default: 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# TLS/SSL - Let's Encrypt
# =============================================================================

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=admin@example.com

# =============================================================================
# API GATEWAY - Traefik
# =============================================================================

# Traefik log level (DEBUG, INFO, WARN, ERROR)
TRAEFIK_LOG_LEVEL=WARN

# =============================================================================
# EMAIL NOTIFICATIONS
# =============================================================================
# You must pick one. There is no safe default: the email service treats an
# unset or unrecognised EMAIL_PROVIDER as 'smtp', and when the provider it
# picked has incomplete settings it does NOT error - it quietly logs the
# message instead of sending it. `npm run validate:production` fails on every
# such combination, so run it after changing anything here.
#
# console  - Writes the email to the container log and sends nothing. Fine for
#            a trial run; validate:production rejects it when NODE_ENV=production.
# smtp     - Any relay (Google Workspace, Microsoft 365, Postmark, Mailgun).
#            Needs SMTP_HOST, SMTP_USER and SMTP_PASS; SMTP_PORT defaults to 587.
# sendgrid - SendGrid's API. Needs SENDGRID_API_KEY and nothing else.
#            The service connects to smtp.sendgrid.net for you.
# ses      - Amazon SES. Needs AWS_REGION plus the two SES SMTP credentials.
#            Set the region explicitly: it defaults to us-east-1, where your
#            sending identity is probably not verified.
EMAIL_PROVIDER=console

# From address and name for all outgoing emails
EMAIL_FROM=noreply@grc.example.com
# Quoted because deploy/backup.sh, deploy/restore.sh and
# scripts/validate-production.sh all `source` this file: an unquoted value with
# a space in it makes the shell try to run the second word as a command.
EMAIL_FROM_NAME="GigaChad GRC"

# -----------------------------------------------------------------------------
# SMTP Configuration (when EMAIL_PROVIDER=smtp)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASS=CHANGE_ME_TO_SECURE_PASSWORD
# SMTP_SECURE=false

# -----------------------------------------------------------------------------
# SendGrid Configuration (when EMAIL_PROVIDER=sendgrid)
# -----------------------------------------------------------------------------
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# AWS SES Configuration (when EMAIL_PROVIDER=ses)
# -----------------------------------------------------------------------------
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# =============================================================================
# MONITORING (Optional - for production observability)
# =============================================================================

# Prometheus metrics endpoint
# METRICS_ENABLED=true
# METRICS_PORT=9090

# Sentry error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup retention in days
BACKUP_RETENTION_DAYS=30

# Off-site copy of each backup archive. These are the names deploy/backup.sh
# actually reads - it uploads with the `aws` CLI, so that must be installed and
# hold credentials (an instance profile, or AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY in this file).
# DR_REMOTE_BACKUP_ENABLED=true
# DR_REMOTE_BACKUP_S3_BUCKET=grc-backups
# DR_REMOTE_BACKUP_REGION=us-east-1

