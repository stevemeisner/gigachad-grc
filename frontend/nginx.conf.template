# Rendered to /etc/nginx/conf.d/default.conf at container start by the nginx
# image's built-in envsubst step, which only substitutes names that exist as
# environment variables -- so nginx's own $uri is left alone.
#
# PORT is templated because most container platforms (Cloud Run, Render,
# Railway, Fly.io, Heroku) inject the port the container must listen on rather
# than letting the image choose. Defaults to 3000 via ENV in the Dockerfile.
server {
    listen ${PORT};
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Handle SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
}



