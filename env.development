# -----------------------------------------------------------------------------
# Authentication (Firebase Authentication - Google sign-in only)
# -----------------------------------------------------------------------------
# AUTH_MODE=demo is the LOCAL BYPASS. It skips Firebase ID token verification
# and loads the seeded demo identity (external_id `demo-user`) straight from
# PostgreSQL, so the demo needs no Firebase project. The backend guard
# hard-throws when NODE_ENV=production, so this cannot leak into a real
# deployment. Unset it and fill in the values below to exercise real Google
# sign-in locally.
AUTH_MODE=demo

# Firebase console > Project settings > General > "Project ID".
FIREBASE_PROJECT_ID=
# Comma-separated email domains allowed to sign in. A Firebase ID token
# carries no `hd` claim, so without this any Google account is accepted.
ALLOWED_EMAIL_DOMAINS=
# Create a user row on first sign-in instead of requiring a seeded one.
AUTH_AUTO_PROVISION=false
# Organization new users are attached to when AUTH_AUTO_PROVISION=true.
AUTH_DEFAULT_ORG_ID=

# -----------------------------------------------------------------------------
# Service Ports
# -----------------------------------------------------------------------------
PORT_CONTROLS=3001
PORT_FRAMEWORKS=3002
PORT_POLICIES=3004
PORT_TPRM=3005
PORT_TRUST=3006
PORT_AUDIT=3007

# -----------------------------------------------------------------------------
# CORS & Rate Limiting
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=30
DR_REMOTE_BACKUP_ENABLED=false
AUTO_BACKUP_ENABLED=false

# -----------------------------------------------------------------------------
# Monitoring & Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
SENTRY_ENABLED=false
METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Leave VITE_API_URL empty in development. The Vite dev server proxies every
# /api/* prefix to the right service (see frontend/vite.config.ts); pointing
# the SPA straight at one service would bypass that routing and break CORS.
VITE_API_URL=
# The Firebase Web API key is a PUBLIC identifier, not a secret: it ships in
# the browser bundle by design. Leave these empty while AUTH_MODE=demo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Frontend counterpart of AUTH_MODE above. The demo sign-in button is gated on
# `import.meta.env.DEV && VITE_AUTH_MODE === 'demo'`, so a production build
# (where import.meta.env.DEV is false) can never show it, whatever this says.
# scripts/start-demo.sh exports this to the Vite process via .env.
VITE_AUTH_MODE=demo
# Optional. Pre-filters the Google account chooser to one domain. This is a UI
# hint ONLY -- a Firebase ID token carries no hosted-domain claim, so the real
# restriction is ALLOWED_EMAIL_DOMAINS above plus a provisioned users row.
VITE_ALLOWED_EMAIL_DOMAIN=
VITE_ERROR_TRACKING_ENABLED=false

# Feature flags - all enabled for development
VITE_ENABLE_COMPLIANCE_MODULE=true
VITE_ENABLE_RISK_MODULE=true
VITE_ENABLE_TPRM_MODULE=true
VITE_ENABLE_BCDR_MODULE=true
VITE_ENABLE_AUDIT_MODULE=true
VITE_ENABLE_TRUST_MODULE=true
VITE_ENABLE_TOOLS_MODULE=true
VITE_ENABLE_AI_MODULE=true

